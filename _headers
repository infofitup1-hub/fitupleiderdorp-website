# Redelijke cachelevensduur voor statische, zelden wijzigende assets.
# HTML-pagina's en _redirects blijven ongemoeid (geen regel = Netlify-standaardgedrag).

/assets/images/*
  Cache-Control: public, max-age=2592000

/assets/videos/*
  Cache-Control: public, max-age=2592000

/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

/favicon.png
  Cache-Control: public, max-age=2592000

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

/tijdelijk-inschrijfrooster/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'
