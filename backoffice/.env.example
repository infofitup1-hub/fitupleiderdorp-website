# =============================================================================
# FIT UP Backoffice — environment variables
# Copy this file to `.env.local` and fill in the values.
# NEVER commit .env.local — it is gitignored on purpose.
# =============================================================================

# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
# Public URL of your Supabase project, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe to expose to the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. Bypasses RLS. Never expose to the browser.
# Used by the import pipeline to write invoices and upload to Storage.
SUPABASE_SERVICE_ROLE_KEY=

# Name of the private Storage bucket that holds the invoice PDFs.
SUPABASE_STORAGE_BUCKET=invoices

# ---------------------------------------------------------------------------
# Google OAuth 2.0 (Google Cloud Console -> APIs & Services -> Credentials)
# ---------------------------------------------------------------------------
# OAuth 2.0 Client ID (type: Web application).
GOOGLE_CLIENT_ID=

# OAuth 2.0 Client secret. SERVER ONLY.
GOOGLE_CLIENT_SECRET=

# Must EXACTLY match one of the "Authorized redirect URIs" in the OAuth client.
# Local dev example:      http://localhost:3000/api/gmail/callback
# Production example:     https://backoffice.example.com/api/gmail/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# ---------------------------------------------------------------------------
# Token encryption
# ---------------------------------------------------------------------------
# 32-byte key, base64-encoded, used to AES-256-GCM encrypt Google tokens
# before they are stored in the database.
# Generate one with:  openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public base URL of the app (no trailing slash). Used for redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
